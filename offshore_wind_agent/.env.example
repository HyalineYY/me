# Copy this to .env and fill in your values

# Anthropic API key (required for LLM analysis)
ANTHROPIC_API_KEY=sk-ant-...

# Email sending (QQ Mail example)
# For QQ Mail: use the app-specific password, not your login password
# Settings > Account > POP3/IMAP/SMTP > Enable SMTP > Get auth code
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_qq@qq.com
SMTP_PASS=your_app_auth_code

# Report recipient
REPORT_RECIPIENT=1873149332@qq.com
